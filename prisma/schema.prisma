generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Proveedor {
  id                    String   @id @default(cuid())
  razonSocial           String
  vendedorNombre        String?
  vendedorCelular       String?
  vendedorCorreo        String?
  contactoAdminNombre   String
  contactoAdminTelefono String?
  contactoAdminCorreo   String
  tipoPersona           String
  rfc                   String   @unique
  domicilio             String
  domicilioComercial    String?
  // JSON con las familias/categorías asignadas al proveedor — independiente
  // de ProveedorMaterial, para que la asignación persista aunque el
  // proveedor todavía no haya seleccionado ningún material específico.
  familiasAsignadas     String?
  // Confirmación del catálogo asignado — true cuando el proveedor revisó y
  // guardó su selección de materiales, o cuando el comprador lo marcó
  // manualmente. Controla si aplica el recordatorio de catálogo.
  catalogoValidado      Boolean  @default(false)
  catalogoValidadoEn    DateTime?
  catalogoValidadoPor   String?
  estado                String   @default("Activo")
  eliminado             Boolean  @default(false)
  eliminadoEn           DateTime?
  clienteId             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  usuarioId             String?  @unique
  usuario               Usuario? @relation(fields: [usuarioId], references: [id])

  licitaciones LicitacionProveedor[]
  ofertas      OfertaItem[]
  asignaciones AsignacionMaterial[]
  ordenes      OrdenCompra[]
  materiales   ProveedorMaterial[]
  mensajes     ChatMensaje[]
}

model Producto {
  id           String   @id @default(cuid())
  codigo       String   @unique
  nombre       String
  tipoItem     String
  familia      String?
  unidadMedida String
  descripcion  String?
  imagenUrl    String?
  especificacionesTecnicas String?
  archivosEspecificaciones String? // JSON con lista de URLs cuando conectemos Supabase Storage
  monedaPredeterminada     String? // TODO: una vez migrada, agregar @default("MXN") vía migración separada (ver nota en el chat)
  codigoManual Boolean  @default(false) // true si el usuario sobrescribió el código autogenerado
  activo       Boolean  @default(true)
  eliminado    Boolean  @default(false)
  eliminadoEn  DateTime?
  clienteId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items       LicitacionItem[]
  proveedores ProveedorMaterial[]
}

model Licitacion {
  id                      String    @id @default(cuid())
  numero                  String    @unique
  jerarquia               String?
  tipoLicitacion          String?
  fechaCreacion           DateTime  @default(now())
  fechaEjecucion          DateTime?
  fechaFinLicitacion      DateTime?
  fechaInicioRangoEntrega DateTime?
  fechaFinRangoEntrega    DateTime?
  costoObjetivo           Float?
  importeVenta            Float?
  // Tipos de cambio manuales congelados por licitación, respecto a MXN.
  // Ej: { "USD": 17.20, "EUR": 19.50 }. MXN siempre vale 1 (no se captura).
  // Al crear se heredan de CatalogoValor (Settings) y quedan congelados aquí.
  // null = licitación anterior a esta función o 100% MXN (ver conversionMoneda.ts).
  tiposCambio             Json?
  // Moneda en la que se consolidan todos los totales/KPIs de la licitación.
  monedaConsolidacion     String    @default("MXN")
  tiempoConfirmacionHoras Int       @default(24)
  duracionRondaMinutos    Int       @default(1440)
  maxRondas               Int       @default(3)
  rondaActual             Int       @default(0)
  inicioRondaActual       DateTime?
  esperandoDecision       Boolean   @default(false)
  estado                  String    @default("Borrador")
  modoLicitacion          String    @default("Proveedores")
  instrucciones           String?
  archivosAdjuntos        String?
  fechaInicioLicitacion   DateTime?
  fechaFinReal            DateTime?
  fechaEsperandoDecision  DateTime?
  fechaCerrada            DateTime?
  fechaFinalizada         DateTime?
  fechaCancelada          DateTime?
  eliminado               Boolean   @default(false)
  eliminadoEn             DateTime?
  compradorId             String
  clienteId               String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  items                LicitacionItem[]
  proveedoresInvitados LicitacionProveedor[]
  asignaciones         AsignacionMaterial[]
  ordenes              OrdenCompra[]
  mensajes             ChatMensaje[]
  estadoLogs           LicitacionEstadoLog[]
}

// Bitácora de cambios de estado de una licitación — una fila por transición.
// Alimenta los KPIs de tiempo por etapa del Tablero de Indicadores.
model LicitacionEstadoLog {
  id             String     @id @default(cuid())
  licitacionId   String
  licitacion     Licitacion @relation(fields: [licitacionId], references: [id])
  // Nulo en la primera entrada (creación) o cuando se desconoce el estado previo.
  estadoAnterior String?
  estadoNuevo    String
  at             DateTime   @default(now())
  // Usuario que provocó el cambio, si está disponible; null en transiciones
  // automáticas (por tiempo) o de sistema.
  usuarioId      String?

  @@index([licitacionId])
}

model LicitacionItem {
  id                 String     @id @default(cuid())
  licitacionId       String
  licitacion         Licitacion @relation(fields: [licitacionId], references: [id])
  productoId         String
  producto           Producto   @relation(fields: [productoId], references: [id])
  especificacion     String?
  fechaEntrega       DateTime?
  cantidadSolicitada Float
  precioObjetivo     Float?
  moneda             String     @default("MXN")
  createdAt          DateTime   @default(now())

  ofertas      OfertaItem[]
  asignaciones AsignacionMaterial[]
  seleccionesPrecio SeleccionPrecioComprador[]
}

// Borrador de trabajo de la pantalla de Selección de Proveedores.
//
// Guarda dos decisiones INDEPENDIENTES del comprador por (partida, proveedor):
//   · ofertaItemId    → "este registro del histórico es el bueno", cuando el
//                       mínimo automático es un dato erróneo que el proveedor
//                       corrigió en una ronda posterior (p. ej. cotizó 1000
//                       pensando en USD y corrigió a 17,448 MXN en la ronda 3).
//   · precioNegociado → el ajuste acordado por teléfono sobre ese precio.
// Ambas nulas = usar el mínimo automático de siempre.
//
// Deliberadamente SEPARADA de AsignacionMaterial: crear filas ahí significaría
// "ya asignado" y la pantalla saltaría de AsignacionForm a SeguimientoView.
// Esto es trabajo en curso, que puede durar días de llamadas a proveedores.
//
// onDelete: Cascade coincide con el FK ya creado en la base. NO es el RESTRICT
// por defecto de Prisma a propósito: editar una licitación borra y recrea sus
// LicitacionItem, y con RESTRICT un borrador guardado haría fallar esa edición.
model SeleccionPrecioComprador {
  id               String         @id @default(cuid())
  licitacionItemId String
  licitacionItem   LicitacionItem @relation(fields: [licitacionItemId], references: [id], onDelete: Cascade)
  proveedorId      String
  ofertaItemId     String?
  precioNegociado  Float?
  actualizadoPor   String?
  actualizadoEn    DateTime       @updatedAt

  @@unique([licitacionItemId, proveedorId])
}

// OJO CON LA MONEDA: la moneda de una línea vive en LicitacionItem.moneda — la
// fija el comprador al crear la licitación y el proveedor cotiza EN esa moneda
// (no elige la suya). El campo `moneda` de aquí abajo NO se escribe en ningún
// lado (ni ofertasActions.ts ni capturaManualActions.ts lo mandan en el create),
// así que siempre vale su default "MXN" y NO es confiable: leerlo para mostrar o
// guardar importes reintroduce el bug de "1,500 USD se muestra como 1,500 MXN".
// Si algún día se decide que el proveedor pueda cotizar en otra moneda, hay que
// poblarlo explícitamente y migrar las filas existentes antes de confiar en él.
model OfertaItem {
  id                   String         @id @default(cuid())
  licitacionItemId     String
  licitacionItem       LicitacionItem @relation(fields: [licitacionItemId], references: [id])
  proveedorId          String
  proveedor            Proveedor      @relation(fields: [proveedorId], references: [id])
  ronda                Int            @default(1)
  precioUnitario       Float
  cantidadDisponible   Float
  // Vía EXPLÍCITA para "no dispongo de esta partida". Antes los proveedores
  // usaban precioUnitario = 0 con ese significado (o dejaban el campo vacío,
  // que el formulario convertía en 0 en silencio), y como 0 es el precio más
  // bajo posible ganaba todos los comparativos: envenenaba "el precio más
  // eficiente", inflaba el ahorro reportado y llegaba a preseleccionar al
  // proveedor como GANADOR a $0 en la pantalla de asignación.
  // Con noDisponible = true, precioUnitario se guarda en 0 pero NO compite:
  // ver esOfertaValida() en src/lib/ofertaValida.ts, por donde pasan todos los
  // cálculos de mínimo.
  noDisponible         Boolean        @default(false)
  // TERCER estado: "no aplica". El proveedor SÍ ofrece la partida, pero en este
  // caso no corresponde cobrarla (da el flete, pero la obra está donde él vive).
  // Es un $0 REAL y competitivo, y ahí está la diferencia con noDisponible:
  //
  //   estado         ¿compite/gana?   ¿entra a la línea base?
  //   precio normal  sí               sí
  //   noDisponible   NO               no
  //   noAplica       SÍ (con $0)      NO   ← el $0 no debe jalar el promedio
  //
  // Por eso hay DOS predicados en ofertaValida.ts y no uno: `esOfertaValida`
  // (¿compite?) y `entraALineaBase` (¿cuenta para el promedio?). Con los dos
  // estados anteriores las respuestas siempre coincidían; este es el primero
  // que las separa.
  //
  // La base la protege un CHECK (`oferta_estado_excluyente`) que impide
  // noDisponible AND noAplica a la vez. Aun así el helper aplica precedencia:
  // noDisponible manda, para que cualquier fila anómala falle del lado seguro.
  noAplica             Boolean        @default(false)
  puedeCumplirFecha    Boolean        @default(true)
  fechaEstimadaEntrega DateTime?
  moneda               String         @default("MXN") // NO CONFIAR — ver nota arriba; la buena es LicitacionItem.moneda
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([licitacionItemId, proveedorId, ronda])
}

model LicitacionProveedor {
  id           String     @id @default(cuid())
  licitacionId String
  licitacion   Licitacion @relation(fields: [licitacionId], references: [id])
  proveedorId  String
  proveedor    Proveedor  @relation(fields: [proveedorId], references: [id])
  invitadoEn   DateTime   @default(now())
}

model AsignacionMaterial {
  id                      String         @id @default(cuid())
  licitacionId            String
  licitacion              Licitacion     @relation(fields: [licitacionId], references: [id])
  licitacionItemId        String
  licitacionItem          LicitacionItem @relation(fields: [licitacionItemId], references: [id])
  proveedorId             String
  proveedor               Proveedor      @relation(fields: [proveedorId], references: [id])
  cantidadAsignada        Float
  precioUnitario          Float
  ronda                   Int
  orden                   Int            @default(1)
  estatusProveedor        String         @default("Pendiente")
  fechaObjetivo           DateTime?
  fechaEstimadaProveedor  DateTime?
  fechaLimiteConfirmacion DateTime?
  fechaConfirmacion       DateTime?
  // Constancia de CUÁNDO se rechazó. Separado de fechaConfirmacion a propósito:
  // aceptar y rechazar son respuestas distintas y conviene poder distinguirlas
  // sin mirar estatusProveedor. Nulo en los rechazos anteriores a este campo.
  fechaRechazo            DateTime?
  motivoRechazo           String?
  moneda                  String         @default("MXN")
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  lineas OrdenCompraLinea[]
}

model OrdenCompra {
  id                   String    @id @default(cuid())
  numero               String    @unique
  licitacionId         String
  licitacion           Licitacion @relation(fields: [licitacionId], references: [id])
  proveedorId          String
  proveedor            Proveedor  @relation(fields: [proveedorId], references: [id])
  estado               String    @default("Pendiente")
  fechaCreacion        DateTime  @default(now())
  fechaEstimadaEntrega DateTime?
  clienteId            String
  updatedAt            DateTime  @updatedAt
  fechaPendiente       DateTime?
  fechaEnTransito      DateTime?
  fechaEntregada       DateTime?
  fechaRecibida        DateTime?
  fechaCancelada       DateTime?

  lineas OrdenCompraLinea[]
}

model ProveedorMaterial {
  id          String   @id @default(cuid())
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])
  productoId  String
  producto    Producto  @relation(fields: [productoId], references: [id])
  familias    String?  // JSON con lista de familias asignadas al proveedor
  createdAt   DateTime @default(now())

  @@unique([proveedorId, productoId])
}

model OrdenCompraLinea {
  id                     String             @id @default(cuid())
  ordenCompraId          String
  ordenCompra            OrdenCompra        @relation(fields: [ordenCompraId], references: [id])
  asignacionId           String             @unique
  asignacion             AsignacionMaterial @relation(fields: [asignacionId], references: [id])
  productoNombre         String
  cantidad               Float
  unidadMedida           String
  precioUnitario         Float
  fechaEntregaObjetivo   DateTime?
  fechaEstimadaProveedor DateTime?
  subtotal               Float
  moneda                 String             @default("MXN")
  createdAt              DateTime           @default(now())
}

model Usuario {
  id               String    @id @default(cuid())
  nombre           String
  apellido         String
  email            String    @unique
  password         String?
  microsoftId      String?
  avatar           String?
  activo           Boolean   @default(true)
  rolId            String
  rol              Rol       @relation(fields: [rolId], references: [id])
  clienteId        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ultimoAcceso     DateTime?
  emailVerificado  Boolean   @default(false)
  primerAcceso     Boolean   @default(true)
  tipoUsuario      String    @default("comprador")
  proveedor        Proveedor?
}

model Rol {
  id           String       @id @default(cuid())
  nombre       String
  descripcion  String?
  esAdmin      Boolean      @default(false)
  esSupervisor Boolean      @default(false)
  clienteId    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  permisos RolPermiso[]
  usuarios Usuario[]
}

model RolPermiso {
  id       String  @id @default(cuid())
  rolId    String
  rol      Rol     @relation(fields: [rolId], references: [id])
  modulo   String
  ver      Boolean @default(false)
  crear    Boolean @default(false)
  editar   Boolean @default(false)
  eliminar Boolean @default(false)

  @@unique([rolId, modulo])
}

model ChatMensaje {
  id           String     @id @default(cuid())
  licitacionId String
  licitacion   Licitacion @relation(fields: [licitacionId], references: [id])
  proveedorId  String
  proveedor    Proveedor  @relation(fields: [proveedorId], references: [id])
  emisor       String
  mensaje      String
  leido        Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model CatalogoValor {
  id        String   @id @default(cuid())
  tipo      String
  codigo    String
  nombre    String
  simbolo   String?
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  // Solo aplica a tipo == "MONEDA" (≠ MXN): tasa a MXN y su última actualización.
  // MXN siempre vale 1 y no se edita. null = tasa aún no capturada.
  tipoCambio            Float?
  tipoCambioActualizado DateTime?
  clienteId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo, codigo, clienteId])
}
